{
  "version": 2,
  "framework": null,
  "functions": {
    "api/handler.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/handler?route=%2Fhealth"
    },
    {
      "source": "/api/cron/notifications",
      "destination": "/api/handler?route=%2Fapi%2Fcron%2Fnotifications"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/notifications",
      "schedule": "0 6 * * *"
    }
  ]
}
